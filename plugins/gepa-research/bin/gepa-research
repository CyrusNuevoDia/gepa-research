#!/usr/bin/env bash
# bin/gepa-research — plugin entry point.
#
# Claude Code adds this `bin/` directory to the Bash tool's PATH when the
# plugin is enabled, so `gepa-research` resolves to this wrapper.
#
# We delegate to `uv run --project <plugin-root>` so dependencies resolve
# against the plugin's own pyproject.toml, not whichever project the user
# happens to be working on.
set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
    cat >&2 <<'EOF'
gepa-research requires `uv` (https://docs.astral.sh/uv/) to manage its Python
environment, and it was not found on PATH.

Install it with one of:

  macOS / Linux :  curl -LsSf https://astral.sh/uv/install.sh | sh
  Homebrew      :  brew install uv
  Windows       :  powershell -c "irm https://astral.sh/uv/install.ps1 | iex"

Then re-run your gepa-research command.
EOF
    exit 127
fi

# The plugin root contains pyproject.toml; point uv at it so uv resolves
# against this plugin's deps, not whichever project the user is working on.
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec uv run --project "$PLUGIN_ROOT" gepa-research "$@"
